APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# APP_DEBUG=true is correct for local development and the test suite.
# It MUST be false when APP_ENV=production: debug mode publishes stack traces,
# configuration and database credentials on any unhandled error, to anyone who
# can trigger one. The application refuses to boot in that combination — see
# app/Support/EnvironmentGuard.php.
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TIMEOUT=30

# OCR (utility/fuel bill extraction)
OCR_SPACE_API_KEY=
TESSERACT_PATH=tesseract

# Multi-tenancy (stancl/tenancy)
# Domains that serve the CENTRAL app — marketing site, admin back-office.
# A tenant subdomain is whatever is left when one of these is stripped from
# the hostname: acme.example.test minus example.test gives tenant 'acme'.
# Comma-separated, no scheme, no port. The FIRST entry is the one used to
# build sign-in URLs, so put your real domain there.
#
# The web server needs a wildcard vhost for *.your-domain pointed at public/.
# Laravel Herd writes one automatically for a linked site.
#
# Locally on Windows, each tenant also needs its own hosts line, the hosts
# file having no wildcard support:
#
#     127.0.0.1 acme.your-domain.test
#
# A wildcard DNS host such as nip.io removes that step on a plain nginx or
# Apache vhost, but NOT under Herd or Valet: their front controller maps the
# hostname to a site directory by the .test convention and answers "Site not
# found" for anything else. In production, wildcard DNS makes the whole
# question disappear.
TENANCY_CENTRAL_DOMAINS=127.0.0.1.nip.io,127.0.0.1,localhost

# Standing developer account created inside every client workspace, so support
# can sign in to one directly.
#
# WARNING: the same credentials open EVERY client. Handing a client their
# database — the point of per-tenant databases — hands over the password hash
# of an account that opens all the others, and one leaked password is not one
# breach but all of them. Leave this off in production and use audited
# impersonation from the back-office instead.
TENANT_DEV_ACCOUNT_ENABLED=false
TENANT_DEV_ACCOUNT_NAME=Developer
TENANT_DEV_ACCOUNT_EMAIL=
TENANT_DEV_ACCOUNT_PASSWORD=
